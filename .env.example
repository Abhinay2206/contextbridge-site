# Public URL of the deployed site. Used for canonical links, Open Graph, sitemap and robots. (required for production)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX). Leave empty to ship with no analytics at all.
NEXT_PUBLIC_GA_ID=

# Optional: Google Search Console verification token (the "content" value of the google-site-verification meta tag).
NEXT_PUBLIC_GSC_VERIFICATION=
